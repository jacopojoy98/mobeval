#!/bin/bash
#PBS -N mobeval_mapmatch
#PBS -q q07daneel
#PBS -l select=1:ncpus=32:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
# Road network + map matching for OmniTraj's road modality (CPU only; no GPU needed).
#   qsub -v CONFIG=$PWD/examples/configs/omnitraj_city.yaml,PBF=$HOME/data/osm/italy-latest.osm.pbf,BBOX="41.75 42.05 12.30 12.70",ROADS_DIR=$HOME/data/roads jobs/mapmatch.pbs
# Writes $ROADS_DIR/network.npz (segments between intersections) and $ROADS_DIR/matched.csv.gz (one
# segment id per GPS point), the files the config's `roads_file` points at. Both are computed in
# this job's scratch directory and copied to ROADS_DIR, which must be in home or a project folder:
# /scratch on the daneel nodes is local to each node, so a training job would not see it there
# (jobs/env.sh's stage_in copies roads_file into the training job's own scratch).
# Download the OSM extract once on a login node, e.g.:
#   wget -P $HOME/data/osm https://download.geofabrik.de/europe/italy-latest.osm.pbf

cd "$PBS_O_WORKDIR"
source jobs/env.sh
: "${PBF:?pass PBF=$HOME/data/osm/italy-latest.osm.pbf}"
: "${ROADS_DIR:?pass ROADS_DIR=$HOME/data/roads}"
case "$(realpath -m "$ROADS_DIR")" in
    /scratch/*) echo "ROADS_DIR=$ROADS_DIR is on /scratch, which is local to this node; use home or a project folder"; exit 2 ;;
esac
setup_env
stage_in

mkdir -p "$ROADS_DIR" "$SCRATCH/roads"
status=0
if [ -f "$ROADS_DIR/network.npz" ]; then
    cp "$ROADS_DIR/network.npz" "$SCRATCH/roads/network.npz"
else
    cp "$PBF" "$SCRATCH/roads/"
    run_mobeval roads --pbf "$SCRATCH/roads/$(basename "$PBF")" ${BBOX:+--bbox $BBOX} \
        --out "$SCRATCH/roads/network.npz" -v || status=$?
    [ $status -eq 0 ] && cp "$SCRATCH/roads/network.npz" "$ROADS_DIR/network.npz"
fi
[ $status -eq 0 ] && { run_mobeval mapmatch --config "$SCRATCH/config.yaml" --roads "$SCRATCH/roads/network.npz" \
    --out "$SCRATCH/roads/matched.csv.gz" --workers "${NCPUS:-8}" -v || status=$?; }
[ $status -eq 0 ] && { cp "$SCRATCH/roads/matched.csv.gz" "$ROADS_DIR/matched.csv.gz"; echo "roads: $ROADS_DIR"; }

explain_exit $status
stage_out
exit $status
