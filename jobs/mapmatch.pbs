#!/bin/bash
#PBS -N mobeval_mapmatch
#PBS -q q07daneel
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=48:00:00
#PBS -j oe
# Road network + map matching for OmniTraj's road modality (CPU only; no GPU needed).
#   qsub -v BBOX="44.80 45.90 8.50 9.80",CITY=milan jobs/mapmatch.pbs
# Variables (pass with -v NAME=value,...; all have defaults):
#   BBOX      "lat_min lat_max lon_min lon_max", the config's prepare.bbox: only roads inside it are
#             read. Without it the whole extract is parsed, which is much slower.
#   CITY      names the output folder (default: milan)
#   CONFIG    the city config (default: examples/configs/omnitraj_city.yaml)
#   PBF       the OpenStreetMap extract (default: $HOME/data/context/italy-latest.osm.pbf)
#   ROADS_DIR where the two result files are kept (default: $HOME/data/roads/$CITY)
# Writes $ROADS_DIR/network.npz (segments between intersections) and $ROADS_DIR/matched.csv.gz (one
# segment id per GPS point), the files the config's `roads_file` points at. Both are computed in
# this job's scratch directory and copied to ROADS_DIR, which must be in home or a project folder:
# /scratch on the daneel nodes is local to each node, so a training job would not see it there
# (jobs/env.sh's stage_in copies roads_file into the training job's own scratch).
# Download the OSM extract once on a login node, e.g.:
#   wget -P $HOME/data/context https://download.geofabrik.de/europe/italy-latest.osm.pbf

cd "$PBS_O_WORKDIR"
# Defaults, so that `qsub -v BBOX="...",CITY=milan jobs/mapmatch.pbs` is enough. Override any with -v.
CONFIG="${CONFIG:-$PWD/examples/configs/omnitraj_city.yaml}"
CITY="${CITY:-milan}"
PBF="${PBF:-$HOME/data/context/italy-latest.osm.pbf}"
ROADS_DIR="${ROADS_DIR:-$HOME/data/roads/$CITY}"
source jobs/env.sh
[ -f "$PBF" ] || { echo "OSM extract not found: $PBF (pass PBF=/path/to/italy-latest.osm.pbf)"; exit 2; }
case "$(realpath -m "$ROADS_DIR")" in
    /scratch/*) echo "ROADS_DIR=$ROADS_DIR is on /scratch, which is local to this node; use home or a project folder"; exit 2 ;;
esac
setup_env
stage_in

PBF="${PBF:-$HOME/data/context/italy-latest.osm.pbf}"
CITY="${CITY:-milan}"
ROADS_OUT="${ROADS_OUT:-$HOME/data/roads/$CITY}"
[ -f "$PBF" ] || { echo "OSM extract not found: $PBF (pass PBF=...)"; exit 1; }
ROADS_DIR="$SCRATCH/roads"
mkdir -p "$ROADS_DIR" "$ROADS_OUT"
cp "$PBF" "$SCRATCH/osm.pbf"
[ -f "$ROADS_OUT/network.npz" ] && cp "$ROADS_OUT/network.npz" "$ROADS_DIR/"     # reuse an earlier network

status=0
if [ ! -f "$ROADS_DIR/network.npz" ]; then
    run_mobeval roads --pbf "$SCRATCH/osm.pbf" ${BBOX:+--bbox $BBOX} --out "$ROADS_DIR/network.npz" -v || status=$?
    [ $status -eq 0 ] && cp "$ROADS_DIR/network.npz" "$ROADS_OUT/"
fi
[ $status -eq 0 ] && { run_mobeval mapmatch --config "$SCRATCH/config.yaml" --roads "$ROADS_DIR/network.npz" \
    --out "$ROADS_DIR/matched.csv.gz" --workers "${NCPUS:-8}" -v || status=$?; }
[ $status -eq 0 ] && { cp "$ROADS_DIR/matched.csv.gz" "$ROADS_OUT/"; echo "roads_file: $ROADS_OUT/matched.csv.gz"; }

explain_exit $status
stage_out
exit $status

