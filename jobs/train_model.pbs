#!/bin/bash
#PBS -N mobeval_train
#PBS -q q07daneel
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
# Train ONE model and write its checkpoint.  GPUs exist only on the daneel queues.
#   qsub -v MODEL=TrajGPT jobs/train_model.pbs
# The job's stdout/stderr end up in mobeval_train.o<jobid> in the submission directory.
#
# The checkpoint is copied to $RESULTS_DIR/checkpoints/ after every epoch that improves, so if
# this job dies or runs out of walltime the best model so far is already there. To carry on from
# it instead of starting over:
#   qsub -v MODEL=TrajGPT,RESUME=1 jobs/train_model.pbs

cd "$PBS_O_WORKDIR"
source jobs/env.sh
setup_env
stage_in
restore_checkpoints

: "${MODEL:?pass the model name: qsub -v MODEL=TrajGPT jobs/train_model.pbs}"
echo "=== training $MODEL ==="
status=0
run_mobeval train --config "$SCRATCH/config.yaml" --models "$MODEL" --device cuda -v \
    ${RESUME:+--resume} || status=$?

stage_out
echo "checkpoint: $RESULTS_DIR/checkpoints/$MODEL.pt"
exit $status
