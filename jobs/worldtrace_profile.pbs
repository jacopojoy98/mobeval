#!/bin/bash
#PBS -N wordtrace_profile
#PBS -q q07daneel
#PBS -l select=1:ncpus=8:mem=64gb
#PBS -l walltime=10:00:00
#PBS -j oe
# Train every model that has no checkpoint yet, then evaluate everything, in a single job.
#   qsub jobs/all_in_one.pbs
# Jobs are NOT re-queued on this cluster and are killed when the walltime expires. Nothing
# finished waits for the end of the job: checkpoints are copied to $RESULTS_DIR after every
# improving epoch and results after every task. Re-submitting with RESUME continues where the
# previous attempt stopped - finished models are skipped, a half-trained one is continued from
# its best epoch, and completed evaluation tasks are kept:
#   qsub -v RESUME=latest jobs/all_in_one.pbs

cd "$PBS_O_WORKDIR"
status=0
module load gcc/10.2.0
module load openssl/1.1.1w
module load python/3.13.11-pytorch
VENV="$HOME/.venv-own"

source $VENV/bin/activate
mkdir /scratch/$USER/data
mkdir /scratch/$USER/data/WorldTrace
mkdir /scratch/$USER/wt_profile

cp -r /home/jcolombini/data/WorldTrace /scratch/$USER/data

python tools/worldtrace_profile.py --raw /scratch/$USER/data/WorldTrace \
    --sample /home/$USER/data/worldtrace_sample.pkl --out /scratch/$USER/wt_profile --workers 32

cp -r /scratch/$USER/wt_profile /home/$USER/data/context

